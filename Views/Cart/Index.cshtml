@model CartViewModel
<div class="section-head"><div><span class="eyebrow">TU SELECCIÓN</span><h1>Carrito de compras</h1></div><a asp-controller="Home" asp-action="Index">← Seguir comprando</a></div>
@if(Model.Lines.Count==0){<div class="empty">🛒<h2>Tu carrito está vacío</h2><a class="btn" asp-controller="Home" asp-action="Index">Ver productos</a></div>}
else{<div class="checkout-layout"><div class="panel">@foreach(var line in Model.Lines){<div class="cart-row"><div class="mini-art">@line.Product.Emoji</div><div><h3>@line.Product.Name</h3><p>Cantidad: @line.Quantity · S/ @line.Product.Price.ToString("N2")</p></div><strong>S/ @line.Subtotal.ToString("N2")</strong><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@line.Product.Id"/><button class="remove">Quitar</button></form></div>}</div><aside class="panel summary"><h2>Resumen</h2><div class="total"><span>Total</span><strong>S/ @Model.Total.ToString("N2")</strong></div><a class="btn full" asp-controller="Checkout" asp-action="Index">Continuar compra →</a></aside></div>}
