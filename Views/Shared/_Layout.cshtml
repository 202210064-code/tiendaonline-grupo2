<body><header class="nav"><a class="brand" asp-controller="Home" asp-action="Index">Nova<span>Shop</span></a><nav><a asp-controller="Home" asp-action="Index">Productos</a><a asp-controller="Cart" asp-action="Index">🛒 Carrito</a></nav></header>
