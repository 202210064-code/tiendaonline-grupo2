@model List<Product>
@{
 string? query = ViewBag.Query; string? category = ViewBag.Category;
 var related = (List<RelatedProduct>)ViewBag.Related;
 string? semanticUnavailable = ViewBag.SemanticUnavailable;
 var filtered = !string.IsNullOrWhiteSpace(query) || !string.IsNullOrWhiteSpace(category);
}
@if(!filtered){
<section class="hero">
 <div><h1>Tecnología y accesorios<br/>para tu día a día</h1><p>Explora el catálogo de URPOnline y arma tu carrito en minutos.</p></div>
 <div class="hero-art">🛍️</div>
</section>
}
<section class="results" id="catalogo">
 <div class="results-head">
  @if(filtered){<p>@Model.Count resultado(s)@if(!string.IsNullOrWhiteSpace(query)){<text> para <b>"@query"</b></text>}@if(!string.IsNullOrWhiteSpace(category)){<text> en <b>@category</b></text>}</p>}
  else{<h2>Productos destacados</h2><span>@Model.Count productos</span>}
 </div>
 @if(Model.Count>0){
 <div class="products">@foreach(var product in Model){<partial name="_ProductCard" model="product"/>}</div>
 }else if(related.Count==0){
 <div class="empty"><h2>No encontramos productos</h2><p>Prueba con otra palabra o categoría.</p><a class="btn-cart inline" asp-controller="Home" asp-action="Index">Ver todo el catálogo</a></div>
 }
</section>
@if(related.Count>0){
<section class="results related">
 <div class="results-head"><h2>Productos relacionados</h2><span>Búsqueda semántica con pgvector</span></div>
 <div class="products">@foreach(var r in related){<partial name="_ProductCard" model="r.Product" view-data='new ViewDataDictionary(ViewData){{"Similarity",r.Similarity}}'/>}</div>
</section>
}
@if(semanticUnavailable!=null && Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment()){
<div class="notice dev">Búsqueda semántica desactivada: @semanticUnavailable</div>
}
