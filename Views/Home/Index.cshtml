@model List<Product>
<section class="hero"><div><span class="eyebrow">TIENDA EN LÍNEA</span><h1>Todo lo que necesitas,<br/><em>en un solo lugar.</em></h1><p>Explora nuestra selección de tecnología y accesorios.</p><a href="#catalogo" class="btn light">Explorar productos →</a></div><div class="hero-art">🛍️</div></section>
<section id="catalogo"><div class="section-head"><div><span class="eyebrow">CATÁLOGO</span><h2>Productos destacados</h2></div><span>@Model.Count productos</span></div>
<form method="get" class="filters"><input name="q" placeholder="Buscar productos..." value="@ViewBag.Query"/><select name="category"><option value="">Todas las categorías</option>@foreach(var cat in new[]{"Tecnología","Accesorios","Fotografía"}) { if(ViewBag.Category == cat){ <option selected value="@cat">@cat</option> }else{ <option value="@cat">@cat</option> } }</select><button class="btn" type="submit">Buscar</button></form>
<div class="products">@foreach(var product in Model){<article class="product"><div class="product-art">@product.Emoji</div><div class="product-info"><small>@product.Category</small><h3>@product.Name</h3><p>@product.Description</p><div class="product-bottom"><strong>S/ @product.Price.ToString("N2")</strong><span>@product.Stock disponibles</span></div><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@product.Id"/><input type="hidden" name="quantity" value="1"/><button class="btn full" disabled="@(product.Stock==0)">@(product.Stock==0 ? "Agotado" : "+ Agregar al carrito")</button></form></div></article>}</div>
@if(Model.Count==0){<p>No encontramos productos.</p>}</section>
